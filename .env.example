# Model backend: cli | anthropic | bedrock | openai | scripted
DEALSIEVE_MODEL_BACKEND=cli
# When backend=cli: claude | codex | agy
DEALSIEVE_CLI_PROVIDER=claude
DEALSIEVE_CLI_MODEL=sonnet
# When backend=anthropic
# ANTHROPIC_API_KEY=
# DEALSIEVE_ANTHROPIC_MODEL=claude-sonnet-5
# When backend=bedrock
# AWS_REGION=us-west-2
# DEALSIEVE_BEDROCK_MODEL=global.anthropic.claude-sonnet-4-6
# Storage
DEALSIEVE_DB_PATH=data/dealsieve.db
DEALSIEVE_POLICY_PATH=config/investment_policy.yaml
# Optional: require this value in X-DealSieve-Approver for approval/rejection/tick.
# When unset, those routes accept loopback clients only.
# DEALSIEVE_APPROVER_TOKEN=
# Notifications: console | telegram
DEALSIEVE_NOTIFIER=console
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Decision memory: local (default, SQLite) | agentcore (Amazon Bedrock AgentCore Memory, write-through to local)
# DEALSIEVE_MEMORY=local
# AGENTCORE_MEMORY_ID=
